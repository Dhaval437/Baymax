# Local mode needs no cloud API key. Copy this file to .env, then configure locally.
AI_PROVIDER=local
LOCAL_MODEL=qwen3:1.7b
PORT=8787
BAYMAX_DEVICE_PORT=8788
# Set to your laptop LAN address for the ESP32, or use Start-Baymax.cmd.
BAYMAX_DEVICE_HOST=127.0.0.1
BAYMAX_DEVICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GEMINI_API_KEY=
GROQ_API_KEY=
